// -- SQLite 历史趋势存储 --
let db = null;
const trends = {};
async function openDatabase() {
  if (db !== null) return db || null;
  db = false;
  try {
    if (typeof $metrix.caniuse === "function" && (await $metrix.caniuse("sqlite"))) {
      const conn = await $metrix.sqlite.open("antigravity_quota");
      await conn.prepare("CREATE TABLE IF NOT EXISTS samples (acct TEXT NOT NULL, bucket TEXT NOT NULL, cycle INTEGER NOT NULL, ts INTEGER NOT NULL, left_pct REAL NOT NULL, PRIMARY KEY (acct, bucket, ts))").run();
      db = conn;
    }
  } catch {}
  return db || null;
}
async function recordSamples(accountKey, buckets) {
  const conn = await openDatabase();
  if (!conn || !buckets.length) return;
  const now = Date.now();
  try {
    for (const b of buckets) {
      const resetCycle = finite(b.resetMs) ? Math.round(b.resetMs) : 0;
      const last = await conn.prepare("SELECT cycle, left_pct FROM samples WHERE acct = ? AND bucket = ? ORDER BY ts DESC LIMIT 1").bind(accountKey, b.seriesKey).first();
      const cycle = last && resetCycle && Math.abs(last.cycle - resetCycle) <= CYCLE_SLACK ? last.cycle : resetCycle;
      if (!last || last.cycle !== cycle || Math.abs(last.left_pct - b.leftPct) >= 0.5) await conn.prepare("INSERT OR REPLACE INTO samples (acct, bucket, cycle, ts, left_pct) VALUES (?, ?, ?, ?, ?)").bind(accountKey, b.seriesKey, cycle, now, b.leftPct).run();
      const rows = await conn.prepare("SELECT ts, left_pct FROM samples WHERE acct = ? AND bucket = ? AND cycle = ? ORDER BY ts").bind(accountKey, b.seriesKey, cycle).all();
      trends[b.seriesKey] = (rows && rows.results) || [];
    }
    await conn.prepare("DELETE FROM samples WHERE ts < ?").bind(now - KEEP_MS).run();
  } catch {}
}

// -- Worker 状态与刷新管线 --
let inputs = {}, accounts = [], activeIdx = null, lastConfiguredIdx = null, snapshot = null, error = "", inflight = null, viewMode = "grouped", search = "", selectedId = "", expandedGroups = new Set(), activity;
const alertedCycles = {};
try {
  const sv = localStorage.getItem("antigravity.viewMode"), sr = localStorage.getItem("antigravity.accountIdx");
  if (sv === "grid" || sv === "grouped") viewMode = sv;
  if (sr !== null && sr !== "") { const n = Number(sr); if (Number.isInteger(n) && n >= 0) activeIdx = n; }
} catch {}

function updateNotchActivity(buckets) {
  if (activity && activity.expiresAt <= Date.now()) activity = undefined;
  if (inputs.notchActivity === false || !buckets.length || buckets[0].leftPct > LOW_QUOTA_THRESHOLD) return;
  const urgent = buckets[0], cycle = finite(urgent.resetMs) ? Math.round(urgent.resetMs / 60e3) : 0;
  if (alertedCycles[urgent.seriesKey] === cycle) return;
  alertedCycles[urgent.seriesKey] = cycle;
  activity = { id: `${urgent.seriesKey}:${cycle}:${clampPct(urgent.leftPct)}`, expiresAt: Date.now() + 8000 };
}
async function fetchAccountSnapshot(account) {
  let lastErr = null;
  const deadline = Date.now() + 11500;
  for (const origin of targetOrigins()) {
    if (lastErr && Date.now() > deadline - 3500) break;
    let token = await resolveAccessToken(account, false);
    for (let attempt = 0; attempt < 2; attempt++) {
      try {
        let projectId = account.projectId || "", plan = "";
        try {
          const assist = await postCloudCode(origin, "loadCodeAssist", token, { metadata: { ideType: "ANTIGRAVITY" }, ...(projectId ? { cloudaicompanionProject: projectId } : {}) });
          const ineligible = parseIneligibleReason(assist);
          if (ineligible) throw Object.assign(new Error(ineligible), { status: 403 });
          if (!projectId && assist && assist.cloudaicompanionProject) { const p = assist.cloudaicompanionProject; projectId = typeof p === "string" ? p.trim() : String((p && (p.id || p.projectId)) || "").trim(); }
          plan = parseTier(assist);
        } catch (e) { if (e && (e.status === 401 || e.status === 403)) throw e; }
