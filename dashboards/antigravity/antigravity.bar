// -- 生命周期导出 --
export default {
  async scheduled(env) { inputs = (env && env.inputs) || inputs; await refresh(); },
  render(env) {
    inputs = (env && env.inputs) || inputs;
    if (activity && activity.expiresAt <= Date.now()) activity = undefined;
