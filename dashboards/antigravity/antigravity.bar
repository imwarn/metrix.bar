}
const buildSummaryText = () => (snapshot && snapshot.groups.length ? snapshot.groups.map(g => `${g.title}: ${g.buckets.map(b => `${b.label} ${pctText(b.leftPct)} (${formatCountdown(b.resetMs)})`).join(" / ")}`).join(" | ") : TITLE);

// -- 原生面板组件 --
const IconButton = (name, label, onClick, busy = false) => h("Column", {
