  for (let i = 0; i < tokens[0].length; i++) { if (tokens.every(t => t[i] === tokens[0][i])) shared.push(tokens[0][i]); else break; }
  return shared.join(" ").replace(/[\s(/-]+$/, "");
}
function buildGroups(models) {
