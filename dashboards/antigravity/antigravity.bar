        const [modelsRes, summaryRes] = await Promise.allSettled([postCloudCode(origin, "fetchAvailableModels", token, reqBody), postCloudCode(origin, "retrieveUserQuotaSummary", token, reqBody)]);
        const reqErrs = [modelsRes, summaryRes].filter(r => r.status === "rejected").map(r => r.reason), fatal = reqErrs.find(e => e && (e.status === 401 || e.status === 429));
        if (fatal) throw fatal;
        let models = modelsRes.status === "fulfilled" ? parseQuotaModels(modelsRes.value) : [];
        let groups = summaryRes.status === "fulfilled" ? parseQuotaSummaryGroups(summaryRes.value, models) : [];
        if (!groups.length && models.length) groups = buildGroups(models);
        if (!models.length && groups.length) models = groups.flatMap(g => g.buckets.map(b => ({ id: b.id, displayName: b.title, family: b.family, isPrimary: b.family === "gemini", leftPct: b.leftPct, resetMs: b.resetMs, isUtility: 0, recommended: 0, pickerRank: Infinity, versionScore: 0, tierScore: 0, effortScore: 0 })));
        if (!models.length && !groups.length) throw reqErrs[0] || lastErr || new Error(T.networkError);
        const email = account.email || (await fetchUserEmail(token, account.key));
        return { accountKey: account.key, accountLabel: email || account.label, plan, origin, models, groups, buckets: flattenBuckets(groups), fetchedAt: Date.now() };
      } catch (e) {
        if (e && e.status === 401 && attempt === 0 && account.refreshToken) { token = await resolveAccessToken(account, true); continue; }
