        try { summaryRaw = await postCloudCode(origin, "retrieveUserQuotaSummary", token, projectId ? { project: projectId } : {}); }
        catch (e) {
          if (e && e.status === 403 && metaFresh) {
            const res = await runAssistCheck(origin, token, ""); projectId = res.projectId; plan = res.plan; metaFresh = false;
            summaryRaw = await postCloudCode(origin, "retrieveUserQuotaSummary", token, projectId ? { project: projectId } : {});
          } else if (e && (e.status === 401 || e.status === 429 || e.network)) throw e;
