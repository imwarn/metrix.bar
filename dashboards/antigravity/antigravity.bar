async function load() {
  const parsed = await readAuthAccounts();
  accounts = parsed.accounts;
  const rawIdx = inputs.accountIndex, configuredIdx = rawIdx !== undefined && rawIdx !== null && rawIdx !== "" && Number.isInteger(Number(rawIdx)) ? Number(rawIdx) : null;
  if (configuredIdx !== null && configuredIdx !== lastConfiguredIdx) { lastConfiguredIdx = configuredIdx; if (activeIdx === null || configuredIdx !== 0) activeIdx = configuredIdx; }
  if (activeIdx === null || activeIdx < 0 || activeIdx >= accounts.length) activeIdx = Math.max(0, Math.min(accounts.length - 1, configuredIdx && configuredIdx > 0 ? configuredIdx : parsed.defaultIdx));
  const next = await fetchAccountSnapshot(accounts[activeIdx] || accounts[0]);
  snapshot = next; await recordSamples(next.accountKey, next.buckets); updateNotchActivity(next.buckets);
}
function refresh() {
  if (inflight) return inflight;
  inflight = load().then(() => { error = ""; }).catch(e => { error = String((e && e.message) || e); }).finally(() => { inflight = null; $metrix.invalidate(); });
  $metrix.invalidate(); return inflight;
}
const launchRefresh = () => { void refresh(); };
