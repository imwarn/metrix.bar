};
const familyLabel = f => ({ gemini: "Gemini Models", claude: "Claude & GPT", gpt: "GPT", other: "Models" })[f] || "Models";
const prettifyModelId = id => String(id).split(/[-_]+/).filter(Boolean).map(w => (/^xhigh$/i.test(w) ? "XHigh" : w.charAt(0).toUpperCase() + w.slice(1))).join(" ");
const shortGroupName = name => String(name || "").replace(/\s+models?$/i, "").replace(/\band\b/i, "&").trim() || "Quota";

function extractModelVersion(id, displayName) {
  const s = `${displayName} ${id}`.toLowerCase();
