}
const extractTierScore = s => (/argon|ultra|opus/.test(s) ? 4 : /carbon|pro|sonnet/.test(s) ? 3 : /hydrogen|neon|flash/.test(s) ? 2 : /lite|haiku|mini/.test(s) ? 1 : 0);
const extractEffortScore = s => (/\bxhigh\b|\bmax\b/.test(s) ? 4 : /\bhigh\b/.test(s) ? 3 : /\bmedium\b/.test(s) ? 2 : /\blow\b/.test(s) ? 1 : 0);
const compareModelsNewestFirst = (a, b) =>
  (a.isUtility - b.isUtility) || (a.pickerRank - b.pickerRank) || (b.recommended - a.recommended) ||
  (b.versionScore - a.versionScore) || (b.tierScore - a.tierScore) || (b.effortScore - a.effortScore) || a.displayName.localeCompare(b.displayName);

function parseQuotaModels(raw) {
