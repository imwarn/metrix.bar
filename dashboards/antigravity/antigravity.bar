        }
        let catalog = meta && Array.isArray(meta.catalog) ? meta.catalog : [];
        let groups = summaryRaw ? parseQuotaSummaryGroups(summaryRaw, catalog) : [];
        const needModels = !groups.length || viewMode === "grid" || !catalog.length;
        let models = [], modelsLive = false;
        if (needModels) {
          try {
            models = parseQuotaModels(await postCloudCode(origin, "fetchAvailableModels", token, projectId ? { project: projectId } : {}));
            modelsLive = true;
            if (models.length) catalog = stripCatalog(models);
            if (summaryRaw) groups = parseQuotaSummaryGroups(summaryRaw, models);
            if (!groups.length && models.length) groups = buildGroups(models);
          } catch (e) {
