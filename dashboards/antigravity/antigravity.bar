    const match = groups.find(g => g.family === m.family && g.rounded === rounded && ((!finite(g.resetMs) && !finite(m.resetMs)) || (finite(g.resetMs) && finite(m.resetMs) && Math.abs(g.resetMs - m.resetMs) <= 120e3)));
    if (match) match.models.push(m);
    else groups.push({ key: `${m.family}:${finite(m.resetMs) ? Math.round(m.resetMs / 120e3) : "none"}:${rounded}`, family: m.family, rounded, leftPct: m.leftPct, resetMs: m.resetMs, models: [m] });
  }
  for (const g of groups) {
