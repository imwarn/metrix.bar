}

function parseQuotaSummaryGroups(raw, allModels) {
  if (!raw || !Array.isArray(raw.groups)) return [];
  const groups = [];
  for (let i = 0; i < raw.groups.length; i++) {
    const grp = raw.groups[i];
    if (!grp || typeof grp !== "object") continue;
    const rawBuckets = Array.isArray(grp.buckets) ? grp.buckets : [], title = String(grp.displayName || grp.name || "").trim() || `Group #${i + 1}`;
    const shortTitle = shortGroupName(title), family = inferFamily(rawBuckets.map(b => (b && (b.bucketId || b.id)) || "").join(" "), title), buckets = [];
    for (const b of rawBuckets) {
      const id = String((b && (b.bucketId || b.id)) || "").trim();
      if (!id) continue;
      const resetMs = parseTimestamp(b.resetTime ?? b.reset_time);
      const remaining = finite(b.remainingFraction) ? b.remainingFraction * 100 : finite(b.remaining_fraction) ? b.remaining_fraction * 100 : finite(resetMs) ? 0 : NaN;
      if (!finite(remaining)) continue;
      const win = String(b.window || "").trim().toLowerCase(), isArgon = /argon/i.test(id);
      const is5h = win === "5h" || /(?:^|[-_])5h(?:$|[-_])/i.test(id), isWeekly = win === "weekly" || /weekly|7d/i.test(id);
      const spanMs = is5h ? H5 : isWeekly ? D7 : 0;
      const label = isArgon && isWeekly ? "ARGON WEEKLY" : is5h ? "5H" : isWeekly ? "WEEKLY" : String(b.displayName || prettifyModelId(id)).toUpperCase();
      const windowRank = is5h ? 0 : isWeekly && !isArgon ? 1 : isArgon ? 2 : 3;
      buckets.push({ id, key: id, label, title: `${shortTitle} · ${label}`, groupTitle: title, seriesKey: `bucket:${id}`, family, windowRank, leftPct: Math.max(0, Math.min(100, remaining)), resetMs, spanMs });
    }
    if (!buckets.length) continue;
    buckets.sort((a, b) => a.windowRank - b.windowRank || a.label.localeCompare(b.label));
    const explicit = Array.isArray(grp.modelIds) ? grp.modelIds : Array.isArray(grp.models) ? grp.models : null;
    let matched = [];
    if (explicit && explicit.length) {
      const keys = new Set(explicit.map(x => String(typeof x === "string" ? x : (x && (x.id || x.model || x.displayName)) || "").toLowerCase()).filter(Boolean));
      matched = allModels.filter(m => keys.has(m.id.toLowerCase()) || keys.has(m.displayName.toLowerCase()));
    }
    if (!matched.length) matched = family === "gemini" ? allModels.filter(m => m.family === "gemini" && !m.isUtility) : (family === "claude" || family === "gpt") ? allModels.filter(m => (m.family === "claude" || m.family === "gpt") && !m.isUtility) : [];
    const resetMs = buckets.reduce((min, b) => (finite(b.resetMs) && b.resetMs < min ? b.resetMs : min), Infinity);
    groups.push({ key: `sum-${i}-${family}`, title, family, buckets, models: matched, leftPct: Math.min(...buckets.map(b => b.leftPct)), resetMs: Number.isFinite(resetMs) ? resetMs : NaN });
  }
