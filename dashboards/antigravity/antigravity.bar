<bar protocol-version="0" min-app-version="0.3.2" id="antigravity" title="Antigravity" version="1.4.0"
     category="ai" license="AGPL-3.0-only" homepage="https://github.com/imwarn/metrix.bar"
     description="Monitor Antigravity model quotas, reset countdowns, and local usage trends."
     refresh="15m" material="glass" placements="menubar" open-mode="flyout" window-style="standard"
     widget="true" notch="true"
     icon="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%202.5%2014.4%209.6%2021.5%2012%2014.4%2014.4%2012%2021.5%209.6%2014.4%202.5%2012%209.6%209.6Z%22%2F%3E%3Ccircle%20cx%3D%2218.5%22%20cy%3D%225.5%22%20r%3D%221.3%22%20fill%3D%22currentColor%22%20stroke%3D%22none%22%2F%3E%3C%2Fsvg%3E">
  <permissions>
    <network origin="https://daily-cloudcode-pa.googleapis.com" />
    <network origin="https://cloudcode-pa.googleapis.com" />
    <network origin="tls://daily-cloudcode-pa.googleapis.com:443" />
    <network origin="tls://cloudcode-pa.googleapis.com:443" />
    <network origin="https://oauth2.googleapis.com" />
    <network origin="https://openidconnect.googleapis.com" />
    <file path="~/.gemini/jetski-standalone-oauth-token" />
    <file path="~/.gemini/antigravity-cli/antigravity-oauth-token" />
    <file path="{{ inputs.authFile }}" />
    <credential service="gemini" account="antigravity" />
  </permissions>
  <inputs>
    <input name="authFile" type="file" label="Auth JSON File (Optional)" help="Optional custom Antigravity / CC Switch auth JSON file. Leave blank to read ~/.gemini local login files first (no Keychain prompt) with Keychain fallback."><locale lang="zh-Hans" label="认证 JSON 文件（可选）" help="可选：自定义导出的认证 JSON。留空时优先静默读取本机 ~/.gemini 登录态文件（无钥匙串弹窗），缺失时回退系统钥匙串。" /></input>
    <input name="credentialsJSON" type="secret" label="Credentials JSON (Optional)" help="Optional manual JSON override stored in Metrix.Bar secure storage. Takes priority over files and Keychain."><locale lang="zh-Hans" label="凭据 JSON（可选）" help="可选手动覆盖内容，优先级高于本地认证文件和系统钥匙串。" /></input>
    <input name="oauthClientId" type="string" label="OAuth Client ID (Optional)" placeholder="Defaults to agy installed-app OAuth client ID" help="Used with refresh_token to renew expired access tokens when client_id is absent from the JSON."><locale lang="zh-Hans" label="OAuth Client ID（可选）" help="当认证 JSON 未自带 client_id 时用于 refresh_token 自动续期；留空默认使用 agy 官方客户端 ID。" /></input>
    <input name="oauthClientSecret" type="secret" label="OAuth Client Secret (Optional)" help="Optional OAuth client_secret for background refresh_token renewal."><locale lang="zh-Hans" label="OAuth Client Secret（可选）" help="可选：用于后台静默续期过期令牌；未填写时直接使用本机 agy 维护的有效 access_token。" /></input>
    <input name="endpoint" type="select" label="Cloud Code Endpoint" default="auto" help="Select the Cloud Code Assist backend host. Auto caches the working endpoint (daily-cloudcode-pa first).">
      <locale lang="zh-Hans" label="Cloud Code 接口端点" help="选择 Cloud Code Assist 后端地址，默认优先使用并缓存 daily-cloudcode-pa。" />
      <option value="auto" label="Auto (Daily -> Production)"><locale lang="zh-Hans" label="自动（Daily 优先并缓存可用端点）" /></option>
      <option value="daily" label="Daily (daily-cloudcode-pa.googleapis.com)"><locale lang="zh-Hans" label="Daily 环境（daily-cloudcode-pa.googleapis.com）" /></option>
      <option value="prod" label="Production (cloudcode-pa.googleapis.com)"><locale lang="zh-Hans" label="生产环境（cloudcode-pa.googleapis.com）" /></option>
    </input>
    <input name="accountIndex" type="integer" label="Default Account Index" default="0" help="Zero-based index used when an auth JSON file contains multiple accounts."><locale lang="zh-Hans" label="默认账号索引" help="当认证 JSON 包含多账号时默认读取的索引（从 0 开始）。" /></input>
    <input name="notchActivity" type="bool" label="Warn in the notch when quota is low" default="true" help="Briefly highlight Antigravity in the notch when any active quota bucket hits the low-quota threshold or is projected to run out early."><locale lang="zh-Hans" label="额度偏低或预警时在刘海中提醒" help="当任意配额桶剩余降至低额度告警阈值及以下或预计提前耗尽时，在刘海中短暂优先展示 Antigravity。" /></input>
    <input name="lowQuotaThreshold" type="integer" label="Low Quota Alert Threshold (%)" default="20" help="Highlight Antigravity in the notch when any active quota bucket drops to or below this percentage (0–95)."><locale lang="zh-Hans" label="低额度告警阈值（%）" help="当任意配额桶剩余降至该百分比及以下（0–95）时触发刘海提醒与告警着色。" /></input>
    <input name="notchForecastAlert" type="bool" label="Warn in the notch when pace runs out early" default="true" help="Also highlight Antigravity in the notch when current consumption pace is projected to exhaust a bucket before reset."><locale lang="zh-Hans" label="预计提前耗尽时在刘海中预警" help="参考官方 Claude Code 看板，当按当前消耗速率预计在重置前提前用完配额时，在刘海岛短暂优先提醒。" /></input>
    <input name="richTray" type="bool" label="Dual-family rich menu bar item (macOS)" default="false" help="Show both Gemini and Claude/GPT lowest quota buckets stacked in the macOS menu bar via native tray.content."><locale lang="zh-Hans" label="启用双行富托盘（macOS）" help="在 macOS 菜单栏通过原生 tray.content 双行同屏展示 Gemini 与 Claude/GPT 最低余量。" /></input>
  </inputs>
  <docs><![CDATA[默认优先静默读取本机 Antigravity / agy 1.5+ 在 ~/.gemini/ 下维护的登录态文件（无钥匙串弹窗），并在内存中缓存有效凭据；仅当本地文件不存在时才在首次启动或手动刷新时回退读取系统钥匙串（gemini / antigravity）。日常按 15 分钟周期单发 retrieveUserQuotaSummary 低频更新 5H 与 WEEKLY 配额，24 小时持久化缓存套餐/项目/模型目录，切换到“卡片网格”时按需拉取单模型实时明细；支持按需开启 macOS 原生双行富托盘（tray.content），并可自定义低额度告警阈值与预计提前耗尽时的刘海预警。]]></docs>
  <script apis="sqlite clipboard localStorage sockets"><![CDATA[
/**
 * [INPUT]: 依赖 Metrix.Bar 宿主 $metrix（readFile/readCredential/secret/sqlite/caniuse）、localStorage、cloudflare:sockets TLS 与 Cloud Code API
 * [OUTPUT]: 导出 Metrix.Bar Worker（scheduled/render/event），低频单请求查询配额并渲染 420px 双焦点圆环仪表、匀速刻度 PaceBar、趋势预测、精简模型胶囊、按需双行富托盘（tray.content）及可配置阈值/提前耗尽预警 Notch/Widget
 * [POS]: dashboards/antigravity 唯一看板源文件（v1.4.0），被 Metrix.Bar 直接加载并由 antigravity.test.cjs 做离线单测
 * [PROTOCOL]: Update this header on change, then check GEMINI.md
 */
// SPDX-License-Identifier: AGPL-3.0-only
// UI/SQLite/Notch/Widget patterns reference official Metrix.Bar AI dashboards (claude-code.bar & codex.bar, AGPL-3.0-only).
// Local agy token/Keychain format and daily-cloudcode-pa quota protocol reference cc-switch.

const h = (type, props, ...children) => ({ type, props: props || {}, children: children.flat(Infinity).filter(c => c !== null && c !== undefined && c !== false) });
const TX = (text, props) => h("Text", props || {}, String(text));
const TITLE = "Antigravity";
const ENDPOINTS = { daily: "https://daily-cloudcode-pa.googleapis.com", prod: "https://cloudcode-pa.googleapis.com" };
const LOCAL_TOKEN_FILES = ["~/.gemini/jetski-standalone-oauth-token", "~/.gemini/antigravity-cli/antigravity-oauth-token"];
const DEFAULT_OAUTH_CLIENT_ID = "1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com";
const AGY_USER_AGENT = "Metrix.Bar/1.4 (antigravity/cli/1.5.15)";
const GO_KEYRING_PREFIX = "go-keyring-base64:";
const K = { muted: "textMuted", hover: "surfaceHover", press: "surfacePressed", track: "border" };
const AUTH_MARGIN_MS = 120e3, EXPAND_STALE_MS = 300e3, META_TTL_MS = 24 * 3600e3, H5 = 5 * 3600e3, D7 = 7 * 864e5;
const CYCLE_SLACK = 15 * 60e3, KEEP_MS = 35 * 864e5, LOW_QUOTA_THRESHOLD = 20, RING = 84;

// -- 图标与双语文案 --
const svg = (body, fill = false) => `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" ${fill ? 'fill="currentColor"' : 'fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"'}>${body}</svg>`;
const BRAND = svg(`<path d="M12 2.5 14.4 9.6 21.5 12 14.4 14.4 12 21.5 9.6 14.4 2.5 12 9.6 9.6Z"/><circle cx="18.5" cy="5.5" r="1.3" fill="currentColor" stroke="none"/>`);
const ICON = {
  mark: BRAND, sparkle: svg(`<path d="M12 3 14.2 9.8 21 12 14.2 14.2 12 21 9.8 14.2 3 12 9.8 9.8Z"/>`, true),
  bot: svg(`<rect x="4" y="8" width="16" height="11" rx="3"/><path d="M12 4v4M9 13.5h.01M15 13.5h.01M8 4h8"/>`),
  refresh: svg(`<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>`),
  clock: svg(`<circle cx="12" cy="12" r="9.5"/><polyline points="12 6.5 12 12 15.5 14"/>`),
  alert: svg(`<circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5"/><path d="M12 16h.01"/>`),
  copy: svg(`<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>`),
  chevronDown: svg(`<path d="m6 9 6 6 6-6"/>`), chevronRight: svg(`<path d="m9 6 6 6-6 6"/>`),
};
const Icon = (name, size = 14, color = K.muted, extra) => h("Icon", { svg: ICON[name] || ICON.mark, fontSize: size, width: size, height: size, textColor: color, shrink: 0, ...extra });

const STRINGS = {
  en: { refresh: "Refresh", copySummary: "Copy summary", copied: "Copied {text}", loading: "Loading Antigravity quotas…", failed: "Couldn’t load quotas", reconnect: "Run `agy` to sign in or refresh your token, then retry.", tryAgain: "Try again", noModels: "No active quota buckets were returned for this account.", noMatch: "No models match your search.", searchPlaceholder: "Search model name or ID", viewGrouped: "Grouped", viewGrid: "Grid", modelsCount: "{n} models", trendTitle: "Trend", remaining: "Left", pace: "Pace", forecast: "Forecast", pastCycles: "Past cycles left", pastCount: "Last {n}", runsOut: "Runs out {time}", aheadPace: "+{n}% vs pace", behindPace: "{n}% vs pace", fastBurn: "Fast", exhausted: "Depleted", elapsed: "{n}% elapsed", resets: "Resets {time}", weekShort: "7d", tagRec: "Top", tagUtil: "Util", resetUnknown: "Reset time unknown", resetNow: "Soon", updatedNow: "Updated just now", updatedAgo: "Updated {time} ago", showAll: "Show all {n} models", collapse: "Collapse", weekdays: ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"], months: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], dateFmt: "{month} {day}", authInvalid: "The Antigravity credential data is not valid JSON.", authNoToken: "No access_token or refresh_token found in credentials.", authNotFound: "No local `agy` login found (checked ~/.gemini and Keychain). Run `agy` in Terminal to sign in first.", keychainDenied: "macOS Keychain access was denied (click “Always Allow” in the prompt, or run `agy` once to write ~/.gemini token files).", keychainAccessOrMissing: "No ~/.gemini token found and Keychain could not be read (if prompted click “Always Allow”, or run `agy` in Terminal to sign in).", authFileError: "Cannot read the configured Auth JSON file ({path}): {reason}", tokenExpired: "The access_token has expired. Run `agy` in Terminal to renew it and click Refresh, or set OAuth Client Secret in Inputs.", refreshFailed: "OAuth token refresh failed (HTTP {status}). Run `agy` to sign in again.", expired: "Authentication expired (HTTP {status}). Run `agy` to refresh your login.", rateLimited: "Cloud Code API rate limited this request. Try again shortly.", httpError: "Cloud Code API returned HTTP {status}.", networkError: "Unable to reach Cloud Code API. Check your network or proxy settings.", invalidResp: "Cloud Code API returned an invalid response." },
  "zh-Hans": { refresh: "刷新", copySummary: "复制额度摘要", copied: "已复制 {text}", loading: "正在加载 Antigravity 模型额度…", failed: "无法加载额度", reconnect: "请在终端运行 `agy` 登录或续期令牌后重试。", tryAgain: "重试", noModels: "当前账号未返回有效配额数据。", noMatch: "没有匹配的模型，请调整搜索关键词。", searchPlaceholder: "搜索模型名称或 ID", viewGrouped: "配额分组", viewGrid: "模型网格", modelsCount: "{n} 个模型", trendTitle: "趋势", remaining: "剩余", pace: "匀速", forecast: "预测", pastCycles: "历史周期期末余量", pastCount: "近 {n} 期", runsOut: "预计 {time} 用完", aheadPace: "较匀速 +{n}%", behindPace: "快于匀速 {n}%", fastBurn: "偏快", exhausted: "已耗尽", elapsed: "时段已过 {n}%", resets: "{time} 重置", weekShort: "周", tagRec: "推荐", tagUtil: "工具", resetUnknown: "重置时间未知", resetNow: "即将重置", updatedNow: "刚刚更新", updatedAgo: "{time}前更新", showAll: "展开全部 {n} 个模型", collapse: "收起", weekdays: ["周日", "周一", "周二", "周三", "周四", "周五", "周六"], months: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"], dateFmt: "{month}{day}日", authInvalid: "Antigravity 认证数据不是有效的 JSON。", authNoToken: "凭据中未找到 access_token 或 refresh_token。", authNotFound: "本机未找到 agy 登录记录（已检查 ~/.gemini 与系统钥匙串，请先在终端完成 `agy` 登录）。", keychainDenied: "系统钥匙串拒绝访问（请在弹窗点击“始终允许”，或在终端运行一次 `agy` 生成 ~/.gemini 本地登录态）。", keychainAccessOrMissing: "未找到 ~/.gemini 本地登录文件，且系统钥匙串读取失败（若弹出钥匙串窗口请点击“始终允许”；若未登录请先在终端完成 `agy` 登录）。", authFileError: "无法读取指定的认证文件（{path}）：{reason}", tokenExpired: "登录令牌已过期（请在终端运行一次 `agy` 续期后点击右上角刷新，或在设置中配置 OAuth Client Secret）。", refreshFailed: "OAuth 令牌续期失败（HTTP {status}），请重新运行 `agy` 登录。", expired: "登录认证已失效（HTTP {status}），请运行 `agy` 刷新令牌后点击刷新。", rateLimited: "Cloud Code 接口请求受限（HTTP 429），请稍后重试。", httpError: "Cloud Code 接口返回 HTTP {status}。", networkError: "无法连接 Cloud Code 接口，请检查网络或代理设置。", invalidResp: "Cloud Code 接口返回了无法解析的数据。" },
};
const T = STRINGS[(() => { for (const tag of (typeof navigator !== "undefined" && navigator.languages) || []) { if (String(tag).toLowerCase().startsWith("zh")) return "zh-Hans"; if (String(tag).toLowerCase().startsWith("en")) return "en"; } return "zh-Hans"; })()];
const fill = (s, v) => String(s).replace(/\{(\w+)\}/g, (_, k) => (v && v[k] != null ? String(v[k]) : ""));

// -- 格式化、语义色与短标签 --
const finite = v => typeof v === "number" && Number.isFinite(v), clampPct = v => Math.max(0, Math.min(100, Math.round(v))), pctText = v => (finite(v) ? `${clampPct(v)}%` : "—");
const effectiveThreshold = () => { const raw = inputs.lowQuotaThreshold; if (raw === undefined || raw === null || raw === "") return LOW_QUOTA_THRESHOLD; const n = Number(raw); return Number.isFinite(n) ? Math.max(0, Math.min(95, Math.round(n))) : LOW_QUOTA_THRESHOLD; };
const quotaTone = v => (!finite(v) ? "textMuted" : v <= 10 ? "danger" : v <= Math.max(30, effectiveThreshold()) ? "warning" : "success"), widgetTone = v => (!finite(v) ? "secondary" : v <= 10 ? "error" : v <= Math.max(30, effectiveThreshold()) ? "warning" : "success");
const pad2 = n => String(n).padStart(2, "0"), hhmm = d => `${pad2(d.getHours())}:${pad2(d.getMinutes())}`, dateOf = d => fill(T.dateFmt, { month: T.months[d.getMonth()], day: d.getDate() });
const formatResetStamp = ms => { if (!finite(ms)) return T.resetUnknown; const d = new Date(ms); return `${d.getFullYear()}/${pad2(d.getMonth() + 1)}/${pad2(d.getDate())} ${hhmm(d)}:${pad2(d.getSeconds())}`; };
const formatShortReset = (ms, now = Date.now()) => { if (!finite(ms)) return "—"; const d = new Date(ms); return ms - now < 864e5 ? hhmm(d) : `${T.weekdays[d.getDay()]} ${hhmm(d)}`; };
const formatCountdown = (ms, now = Date.now()) => { if (!finite(ms)) return "—"; const diff = ms - now; if (diff <= 0) return T.resetNow; const m = Math.floor(diff / 60e3), d = Math.floor(m / 1440), hr = Math.floor((m % 1440) / 60), mn = m % 60; return d > 0 ? (hr > 0 ? `${d}d ${hr}h` : `${d}d`) : hr > 0 ? (mn > 0 ? `${hr}h ${mn}m` : `${hr}h`) : `${Math.max(1, mn)}m`; };
const formatUpdated = (ts, now = Date.now()) => { if (!ts) return ""; const s = Math.max(0, Math.floor((now - ts) / 1000)); return s < 45 ? T.updatedNow : fill(T.updatedAgo, { time: s < 3600 ? `${Math.floor(s / 60)}m` : s < 86400 ? `${Math.floor(s / 3600)}h` : `${Math.floor(s / 86400)}d` }); };
const shortModelLabel = m => { const raw = String((m && (m.displayName || m.id)) || "").trim(); return raw ? raw.replace(/^Gemini\s+4\s+/i, "").replace(/^Gemini\s+(?=\d)/i, "").replace(/^Claude\s+/i, "").replace(/\s*\(([^)]+)\)\s*/g, " $1 ").replace(/\s+Preview$/i, "").replace(/\s+/g, " ").trim() || raw : ""; };
const shortBucketChip = b => { const fam = b.family === "gemini" ? "Gem" : (b.family === "claude" || b.family === "gpt") ? "C&G" : shortGroupName(b.groupTitle).slice(0, 5), lbl = String(b.label || "").toUpperCase(); return `${fam} ${lbl.includes("ARGON") ? (T.weekShort === "周" ? "Arg周" : "Arg7d") : lbl.includes("WEEK") ? T.weekShort : lbl.includes("5H") ? "5H" : b.label}`.trim(); };
const parseTimestamp = raw => { if (raw == null || raw === "") return NaN; if (typeof raw === "number" && Number.isFinite(raw)) return raw < 1e12 ? raw * 1000 : raw; if (typeof raw === "string") { const s = raw.trim(); if (/^\d+(\.\d+)?$/.test(s)) { const n = Number(s); return n < 1e12 ? n * 1000 : n; } const p = Date.parse(s); return Number.isFinite(p) ? p : NaN; } return NaN; };
const decodeBase64Utf8 = b64 => { const bin = atob(String(b64 || "").replace(/\s+/g, "")), bytes = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i); return typeof TextDecoder === "function" ? new TextDecoder().decode(bytes) : bin; };
const jwtEmail = idToken => { const part = typeof idToken === "string" ? idToken.split(".")[1] : ""; if (!part) return ""; try { const c = JSON.parse(decodeBase64Utf8(part.replace(/-/g, "+").replace(/_/g, "/") + "===".slice((part.length + 3) % 4))); return typeof c.email === "string" ? c.email.trim() : ""; } catch { return ""; } };

// -- 凭据解析、内存缓存（防钥匙串高频弹窗）与精确异常诊断 --
function decodeCredentialPayload(raw) {
  const trimmed = String(raw || "").trim(), jsonText = trimmed.startsWith(GO_KEYRING_PREFIX) ? decodeBase64Utf8(trimmed.slice(GO_KEYRING_PREFIX.length)) : trimmed;
  let doc; try { doc = JSON.parse(jsonText); } catch { throw new Error(T.authInvalid); }
  if (!doc || typeof doc !== "object") throw new Error(T.authInvalid); return doc;
}
function normalizeAccount(entry, idx) {
  if (!entry || typeof entry !== "object") return null;
  const cred = entry.credential && typeof entry.credential === "object" ? entry.credential : entry;
  const nested = cred.token || cred.tokens || cred.credentials || cred.oauth || {};
  const pick = (...vals) => { for (const v of vals) if (typeof v === "string" && v.trim()) return v.trim(); return ""; };
  const accessToken = pick(cred.access_token, cred.accessToken, nested.access_token, nested.accessToken);
  const refreshToken = pick(cred.refresh_token, cred.refreshToken, nested.refresh_token, nested.refreshToken);
  if (!accessToken && !refreshToken) return null;
  const projectObj = cred.cloudaicompanionProject || cred.project || entry.project || nested.project;
  const projectId = pick(entry.project_id, entry.projectId, cred.project_id, cred.projectId, typeof projectObj === "string" ? projectObj : projectObj && projectObj.id, nested.project_id, nested.projectId);
  const expiresAt = parseTimestamp(cred.expiry ?? nested.expiry ?? cred.expires_at ?? cred.expiresAt ?? cred.expired ?? cred.expiry_date ?? cred.expiryDate ?? nested.expires_at ?? nested.expiresAt ?? nested.expired ?? nested.expiry_date ?? nested.expiryDate);
  const idToken = pick(cred.id_token, cred.idToken, nested.id_token, nested.idToken);
  const email = pick(entry.email, cred.email, cred.id_token_email, entry.account, entry.userEmail, nested.email) || jwtEmail(idToken);
  const clientId = pick(cred.client_id, cred.clientId, nested.client_id, nested.clientId), clientSecret = pick(cred.client_secret, cred.clientSecret, nested.client_secret, nested.clientSecret);
  const label = email || projectId || `Account #${idx + 1}`, key = email || entry.sub || projectId || (refreshToken ? `rt:${refreshToken.slice(-8)}` : `at:${accessToken.slice(-8)}`);
  return { key, label, email, accessToken, refreshToken, expiresAt, projectId, clientId, clientSecret };
}
function parseAuthJSON(raw) {
  const doc = decodeCredentialPayload(raw), list = [];
  let defaultIdx = 0;
