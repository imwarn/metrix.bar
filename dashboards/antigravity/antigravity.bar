<bar protocol-version="0" min-app-version="0.3.0" id="antigravity" title="Antigravity" version="1.2.0"
     category="ai" license="AGPL-3.0-only" homepage="https://github.com/imwarn/metrix.bar"
     description="Monitor Antigravity model quotas, reset countdowns, and local usage trends."
     refresh="5m" material="glass" placements="menubar" open-mode="flyout" window-style="standard"
     widget="true" notch="true"
     icon="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%202.5%2014.4%209.6%2021.5%2012%2014.4%2014.4%2012%2021.5%209.6%2014.4%202.5%2012%209.6%209.6Z%22%2F%3E%3Ccircle%20cx%3D%2218.5%22%20cy%3D%225.5%22%20r%3D%221.3%22%20fill%3D%22currentColor%22%20stroke%3D%22none%22%2F%3E%3C%2Fsvg%3E">
  <permissions>
    <network origin="https://daily-cloudcode-pa.googleapis.com" />
    <network origin="https://cloudcode-pa.googleapis.com" />
    <network origin="tls://daily-cloudcode-pa.googleapis.com:443" />
    <network origin="tls://cloudcode-pa.googleapis.com:443" />
    <network origin="https://oauth2.googleapis.com" />
    <network origin="https://openidconnect.googleapis.com" />
    <file path="{{ inputs.authFile }}" />
    <credential service="gemini" account="antigravity" />
  </permissions>
  <inputs>
    <input name="authFile" type="file" label="Auth JSON File (Optional)" help="Optional exported Antigravity / CC Switch auth JSON file. Leave blank to read the agy CLI login from the system Keychain (service: gemini, account: antigravity).">
      <locale lang="zh-Hans" label="认证 JSON 文件（可选）" help="可选：自定义导出的 Antigravity / CC Switch 认证 JSON。留空时自动从系统钥匙串读取本机 agy CLI 登录凭据（gemini / antigravity）。" />
    </input>
    <input name="credentialsJSON" type="secret" label="Credentials JSON (Optional)" help="Optional manual JSON override stored in the OS Keychain. Takes priority over Auth JSON File and agy Keychain.">
      <locale lang="zh-Hans" label="凭据 JSON（可选）" help="可选手动覆盖内容，保存在系统钥匙串中，优先级高于本地认证文件和 agy 钥匙串。" />
    </input>
    <input name="oauthClientId" type="string" label="OAuth Client ID (Optional)" placeholder="Defaults to agy installed-app OAuth client ID" help="Used with refresh_token to renew expired access tokens when client_id is absent from the JSON.">
      <locale lang="zh-Hans" label="OAuth Client ID（可选）" help="当认证 JSON 未自带 client_id 时用于 refresh_token 自动续期；留空默认使用 agy 官方客户端 ID。" />
    </input>
    <input name="oauthClientSecret" type="secret" label="OAuth Client Secret (Optional)" help="Optional OAuth client_secret stored in Keychain for background refresh_token renewal.">
      <locale lang="zh-Hans" label="OAuth Client Secret（可选）" help="可选：用于后台自动续期过期令牌；未填写时直接使用 agy 钥匙串中的有效 access_token。" />
    </input>
    <input name="endpoint" type="select" label="Cloud Code Endpoint" default="auto" help="Select the Cloud Code Assist backend host. Auto matches agy CLI (daily-cloudcode-pa first).">
      <locale lang="zh-Hans" label="Cloud Code 接口端点" help="选择 Cloud Code Assist 后端地址，默认与 agy CLI 一致（优先 daily-cloudcode-pa）。" />
      <option value="auto" label="Auto (Daily -> Production)"><locale lang="zh-Hans" label="自动（Daily 优先，失败回退生产）" /></option>
      <option value="daily" label="Daily (daily-cloudcode-pa.googleapis.com)"><locale lang="zh-Hans" label="Daily 环境（daily-cloudcode-pa.googleapis.com）" /></option>
      <option value="prod" label="Production (cloudcode-pa.googleapis.com)"><locale lang="zh-Hans" label="生产环境（cloudcode-pa.googleapis.com）" /></option>
    </input>
    <input name="accountIndex" type="integer" label="Default Account Index" default="0" help="Zero-based index used when an auth JSON file contains multiple accounts.">
      <locale lang="zh-Hans" label="默认账号索引" help="当认证 JSON 包含多账号时默认读取的索引（从 0 开始）。" />
    </input>
    <input name="notchActivity" type="bool" label="Warn in the notch when quota is low" default="true" help="Briefly highlight Antigravity in the notch when any active model group drops to 20% or below.">
      <locale lang="zh-Hans" label="额度偏低时在刘海中提醒" help="当任意模型配额组剩余降至 20% 及以下时，在刘海中短暂优先展示 Antigravity。" />
    </input>
  </inputs>
  <docs><![CDATA[默认自动读取本机 Antigravity CLI（agy）保存在系统钥匙串（service: gemini, account: antigravity）中的官方登录状态，无需手动导出文件。也支持在输入项中选择自定义认证 JSON（兼容单账号、accounts 数组与 CC Switch agy_accounts.json）或粘贴到“凭据 JSON”。直连 daily-cloudcode-pa.googleapis.com 查询当前账号下有额度的模型与配额桶，支持“配额分组”与“卡片网格”双视图、SQLite 趋势、Notch 与桌面小组件。]]></docs>
  <script apis="sqlite clipboard localStorage sockets"><![CDATA[
/**
 * [INPUT]: 依赖 Metrix.Bar 宿主 $metrix（readCredential/readFile/secret/sqlite/caniuse）、cloudflare:sockets TLS 与 Cloud Code API
 * [OUTPUT]: 导出 Metrix.Bar Worker（scheduled/render/event），渲染托盘、双视图面板、Notch 与三尺寸桌面小组件
 * [POS]: dashboards/antigravity 唯一看板源文件，被 Metrix.Bar 直接加载并由 antigravity.test.cjs 做离线单测
 * [PROTOCOL]: Update this header on change, then check GEMINI.md
 */
// SPDX-License-Identifier: AGPL-3.0-only
// UI/SQLite/Notch/Widget patterns reference official Metrix.Bar AI dashboards (claude-code.bar & codex.bar, AGPL-3.0-only).
// Local agy Keychain format (go-keyring-base64:) and daily-cloudcode-pa quota protocol reference cc-switch.

const h = (type, props, ...children) => ({ type, props: props || {}, children: children.flat(Infinity).filter(c => c !== null && c !== undefined && c !== false) });
const TX = (text, props) => h("Text", props || {}, String(text));
const TITLE = "Antigravity";
const ENDPOINTS = { daily: "https://daily-cloudcode-pa.googleapis.com", prod: "https://cloudcode-pa.googleapis.com" };
const DEFAULT_OAUTH_CLIENT_ID = "1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com";
const AGY_USER_AGENT = "Metrix.Bar/1.1 (antigravity/cli/1.5.5)";
const GO_KEYRING_PREFIX = "go-keyring-base64:";
const K = { muted: "textMuted", hover: "surfaceHover", press: "surfacePressed", track: "border" };
const CYCLE_SLACK = 15 * 60e3, KEEP_MS = 35 * 864e5, LOW_QUOTA_THRESHOLD = 20;

// -- 图标与双语文案 --
const svg = (body, fill = false) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" ${fill ? 'fill="currentColor"' : 'fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"'}>${body}</svg>`;
const BRAND = svg(`<path d="M12 2.5 14.4 9.6 21.5 12 14.4 14.4 12 21.5 9.6 14.4 2.5 12 9.6 9.6Z"/><circle cx="18.5" cy="5.5" r="1.3" fill="currentColor" stroke="none"/>`);
const ICON = {
  mark: BRAND, sparkle: svg(`<path d="M12 3 14.2 9.8 21 12 14.2 14.2 12 21 9.8 14.2 3 12 9.8 9.8Z"/>`, true),
  bot: svg(`<rect x="4" y="8" width="16" height="11" rx="3"/><path d="M12 4v4M9 13.5h.01M15 13.5h.01M8 4h8"/>`),
  refresh: svg(`<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>`),
  clock: svg(`<circle cx="12" cy="12" r="9.5"/><polyline points="12 6.5 12 12 15.5 14"/>`),
  alert: svg(`<circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5"/><path d="M12 16h.01"/>`),
  copy: svg(`<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>`),
  chevronDown: svg(`<path d="m6 9 6 6 6-6"/>`), chevronRight: svg(`<path d="m9 6 6 6-6 6"/>`),
};
const Icon = (name, size = 14, color = K.muted, extra) => h("Icon", { svg: ICON[name] || ICON.mark, fontSize: size, width: size, height: size, textColor: color, shrink: 0, ...extra });

const STRINGS = {
  en: {
    refresh: "Refresh", copySummary: "Copy summary", copied: "Copied {text}", loading: "Loading Antigravity quotas…", failed: "Couldn’t load quotas",
    reconnect: "Sign in with `agy` and allow Keychain access, or set an auth JSON.", tryAgain: "Try again", noModels: "No models with active quota were returned for this account.",
    noMatch: "No models match your search.", searchPlaceholder: "Search model name or ID", viewGrouped: "Grouped", viewGrid: "Grid",
    modelsCount: "{n} models", modelCountOne: "1 model", lowestQuota: "Lowest", nextReset: "Next reset", activeModels: "Quota models", trend: "Quota trend",
    remaining: "Left", resetUnknown: "Reset time unknown", resetNow: "Soon", updatedNow: "Updated just now", updatedAgo: "Updated {time} ago",
    showAll: "Show all {n} models", collapse: "Collapse", authInvalid: "The Antigravity credential data is not valid JSON.", authNoToken: "No access_token or refresh_token found in credentials.",
    authMissing: "Sign in with `agy` first and allow Metrix.Bar to read the Keychain item (gemini / antigravity), or select an exported auth JSON in Inputs.",
    refreshNeedsClient: "The access_token has expired. Run `agy` once to renew it, or provide OAuth Client Secret in Inputs for automatic renewal.",
    refreshFailed: "OAuth token refresh failed (HTTP {status}). Run `agy` to sign in again.", expired: "Authentication expired (HTTP {status}). Run `agy` to refresh your login.",
    rateLimited: "Cloud Code API rate limited this request. Try again shortly.", httpError: "Cloud Code API returned HTTP {status}.",
    networkError: "Unable to reach Cloud Code API. Check your network or proxy settings.", invalidResp: "Cloud Code API returned an invalid response.",
  },
  "zh-Hans": {
    refresh: "刷新", copySummary: "复制额度摘要", copied: "已复制 {text}", loading: "正在加载 Antigravity 模型额度…", failed: "无法加载额度",
    reconnect: "请先使用 `agy` 登录并允许访问系统钥匙串，或在设置中指定认证 JSON。", tryAgain: "重试", noModels: "当前账号未返回包含额度的模型。",
    noMatch: "没有匹配的模型，请调整搜索关键词。", searchPlaceholder: "搜索模型名称或 ID", viewGrouped: "配额分组", viewGrid: "卡片网格",
    modelsCount: "{n} 个模型", modelCountOne: "1 个模型", lowestQuota: "最低剩余", nextReset: "最近重置", activeModels: "有额度模型", trend: "剩余趋势",
    remaining: "剩余", resetUnknown: "重置时间未知", resetNow: "即将重置", updatedNow: "刚刚更新", updatedAgo: "{time}前更新",
    showAll: "展开全部 {n} 个模型", collapse: "收起", authInvalid: "Antigravity 认证数据不是有效的 JSON。", authNoToken: "凭据中未找到 access_token 或 refresh_token。",
    authMissing: "无法读取本机 agy 钥匙串凭据（gemini / antigravity）或认证文件。请先运行 `agy` 登录并允许钥匙串访问，或在看板设置中填写认证 JSON。",
    refreshNeedsClient: "当前 access_token 已过期。请运行一次 `agy` 刷新本机令牌，或在看板设置中补充 OAuth Client Secret 以启用后台自动续期。",
    refreshFailed: "OAuth 令牌续期失败（HTTP {status}），请重新运行 `agy` 登录。", expired: "登录认证已失效（HTTP {status}），请运行 `agy` 重新登录或刷新令牌。",
    rateLimited: "Cloud Code 接口请求受限（HTTP 429），请稍后重试。", httpError: "Cloud Code 接口返回 HTTP {status}。",
    networkError: "无法连接 Cloud Code 接口，请检查网络或代理设置。", invalidResp: "Cloud Code 接口返回了无法解析的数据。",
  },
};
const T = STRINGS[(() => { for (const tag of (typeof navigator !== "undefined" && navigator.languages) || []) { if (String(tag).toLowerCase().startsWith("zh")) return "zh-Hans"; if (String(tag).toLowerCase().startsWith("en")) return "en"; } return "zh-Hans"; })()];
const fill = (s, v) => String(s).replace(/\{(\w+)\}/g, (_, k) => (v && v[k] != null ? String(v[k]) : ""));

// -- 格式化与语义色 --
const finite = v => typeof v === "number" && Number.isFinite(v);
const clampPct = v => Math.max(0, Math.min(100, Math.round(v)));
const pctText = v => (finite(v) ? `${clampPct(v)}%` : "—");
const quotaTone = v => (!finite(v) ? "textMuted" : v <= 10 ? "danger" : v <= 30 ? "warning" : "success");
const widgetTone = v => (!finite(v) ? "secondary" : v <= 10 ? "error" : v <= 30 ? "warning" : "success");
const pad2 = n => String(n).padStart(2, "0");

function formatResetStamp(ms) {
  if (!finite(ms)) return T.resetUnknown;
  const d = new Date(ms);
  return `${d.getFullYear()}/${pad2(d.getMonth() + 1)}/${pad2(d.getDate())} ${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;
}
function formatCountdown(ms, now = Date.now()) {
  if (!finite(ms)) return "—";
  const diff = ms - now;
  if (diff <= 0) return T.resetNow;
  const minsTotal = Math.floor(diff / 60e3), days = Math.floor(minsTotal / 1440), hours = Math.floor((minsTotal % 1440) / 60), mins = minsTotal % 60;
  return days > 0 ? (hours > 0 ? `${days}d ${hours}h` : `${days}d`) : hours > 0 ? (mins > 0 ? `${hours}h ${mins}m` : `${hours}h`) : `${Math.max(1, mins)}m`;
}
function formatUpdated(ts, now = Date.now()) {
  if (!ts) return "";
  const secs = Math.max(0, Math.floor((now - ts) / 1000));
  if (secs < 45) return T.updatedNow;
  const time = secs < 3600 ? `${Math.floor(secs / 60)}m` : secs < 86400 ? `${Math.floor(secs / 3600)}h` : `${Math.floor(secs / 86400)}d`;
  return fill(T.updatedAgo, { time });
}
function parseTimestamp(raw) {
  if (raw == null || raw === "") return NaN;
  if (typeof raw === "number" && Number.isFinite(raw)) return raw < 1e12 ? raw * 1000 : raw;
  if (typeof raw === "string") {
    const s = raw.trim();
    if (/^\d+(\.\d+)?$/.test(s)) { const n = Number(s); return n < 1e12 ? n * 1000 : n; }
    const parsed = Date.parse(s);
    return Number.isFinite(parsed) ? parsed : NaN;
  }
  return NaN;
}
function decodeBase64Utf8(b64) {
  const bin = atob(String(b64 || "").replace(/\s+/g, "")), bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return typeof TextDecoder === "function" ? new TextDecoder().decode(bytes) : bin;
}
function jwtEmail(idToken) {
  const part = typeof idToken === "string" ? idToken.split(".")[1] : "";
  if (!part) return "";
  try {
    const claims = JSON.parse(decodeBase64Utf8(part.replace(/-/g, "+").replace(/_/g, "/") + "===".slice((part.length + 3) % 4)));
    return typeof claims.email === "string" ? claims.email.trim() : "";
  } catch { return ""; }
}

// -- 凭据读取（钥匙串 go-keyring-base64 + 认证 JSON）与令牌续期 --
function decodeCredentialPayload(raw) {
  const trimmed = String(raw || "").trim();
  const jsonText = trimmed.startsWith(GO_KEYRING_PREFIX) ? decodeBase64Utf8(trimmed.slice(GO_KEYRING_PREFIX.length)) : trimmed;
  let doc;
  try { doc = JSON.parse(jsonText); } catch { throw new Error(T.authInvalid); }
  if (!doc || typeof doc !== "object") throw new Error(T.authInvalid);
  return doc;
}
function normalizeAccount(entry, idx) {
  if (!entry || typeof entry !== "object") return null;
  const cred = entry.credential && typeof entry.credential === "object" ? entry.credential : entry;
  const nested = cred.token || cred.tokens || cred.credentials || cred.oauth || {};
  const pick = (...vals) => { for (const v of vals) if (typeof v === "string" && v.trim()) return v.trim(); return ""; };
  const accessToken = pick(cred.access_token, cred.accessToken, nested.access_token, nested.accessToken);
  const refreshToken = pick(cred.refresh_token, cred.refreshToken, nested.refresh_token, nested.refreshToken);
  if (!accessToken && !refreshToken) return null;
  const projectObj = cred.cloudaicompanionProject || cred.project || entry.project || nested.project;
  const projectId = pick(entry.project_id, entry.projectId, cred.project_id, cred.projectId, typeof projectObj === "string" ? projectObj : projectObj && projectObj.id, nested.project_id, nested.projectId);
  const expiresAt = parseTimestamp(cred.expiry ?? nested.expiry ?? cred.expires_at ?? cred.expiresAt ?? cred.expired ?? cred.expiry_date ?? cred.expiryDate ?? nested.expires_at ?? nested.expiresAt ?? nested.expired ?? nested.expiry_date ?? nested.expiryDate);
  const idToken = pick(cred.id_token, cred.idToken, nested.id_token, nested.idToken);
  const email = pick(entry.email, cred.email, cred.id_token_email, entry.account, entry.userEmail, nested.email) || jwtEmail(idToken);
  const clientId = pick(cred.client_id, cred.clientId, nested.client_id, nested.clientId);
  const clientSecret = pick(cred.client_secret, cred.clientSecret, nested.client_secret, nested.clientSecret);
  const label = email || projectId || `Account #${idx + 1}`;
  const key = email || entry.sub || projectId || (refreshToken ? `rt:${refreshToken.slice(-8)}` : `at:${accessToken.slice(-8)}`);
  return { key, label, email, accessToken, refreshToken, expiresAt, projectId, clientId, clientSecret };
}
function parseAuthJSON(raw) {
  const doc = decodeCredentialPayload(raw), list = [];
  let defaultIdx = 0;
  const pushAll = arr => arr.forEach((item, i) => { const a = normalizeAccount(item, i); if (a) list.push(a); });
  if (Array.isArray(doc)) pushAll(doc);
  else if (Array.isArray(doc.accounts)) {
    pushAll(doc.accounts);
    if (Number.isInteger(doc.activeIndex) && doc.activeIndex >= 0 && doc.activeIndex < list.length) defaultIdx = doc.activeIndex;
    else if (typeof doc.activeEmail === "string") { const found = list.findIndex(a => a.email === doc.activeEmail); if (found >= 0) defaultIdx = found; }
  } else if (doc.accounts && typeof doc.accounts === "object") pushAll(Object.values(doc.accounts));
  else { const single = normalizeAccount(doc, 0); if (single) list.push(single); }
  if (!list.length) throw new Error(T.authNoToken);
  return { accounts: list, defaultIdx };
}
async function readAuthAccounts() {
  let raw = "";
  try { raw = $metrix.secret("credentialsJSON") || ""; } catch {}
  if (!raw.trim()) { const p = String(inputs.authFile || "").trim(); if (p) { try { raw = await $metrix.readFile(p); } catch {} } }
  if (!raw.trim() && typeof $metrix.readCredential === "function") { try { raw = await $metrix.readCredential("gemini", "antigravity"); } catch {} }
  if (!raw || !raw.trim()) throw new Error(T.authMissing);
  return parseAuthJSON(raw);
}

const tokenCache = new Map(), emailCache = new Map();
async function refreshAccessToken(account) {
  const clientId = account.clientId || String(inputs.oauthClientId || "").trim() || DEFAULT_OAUTH_CLIENT_ID;
  let clientSecret = account.clientSecret || "";
  if (!clientSecret) { try { clientSecret = ($metrix.secret("oauthClientSecret") || "").trim(); } catch {} }
  if (!account.refreshToken || !clientId || !clientSecret) throw new Error(T.refreshNeedsClient);
  const body = new URLSearchParams({ grant_type: "refresh_token", refresh_token: account.refreshToken, client_id: clientId, client_secret: clientSecret });
  let res;
  try { res = await fetch("https://oauth2.googleapis.com/token", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded", Accept: "application/json" }, body: body.toString() }); }
  catch { throw new Error(T.networkError); }
  const text = await res.text();
  if (!res.ok) throw new Error(fill(T.refreshFailed, { status: res.status }));
  let parsed;
  try { parsed = JSON.parse(text); } catch { throw new Error(T.invalidResp); }
  if (!parsed || typeof parsed.access_token !== "string" || !parsed.access_token) throw new Error(T.invalidResp);
  const next = { accessToken: parsed.access_token, expiresAt: Date.now() + (Number(parsed.expires_in) || 3600) * 1000 };
  tokenCache.set(account.key, next);
  return next.accessToken;
}
async function resolveAccessToken(account, forceRefresh = false) {
  const now = Date.now(), margin = 60e3, cached = tokenCache.get(account.key);
  if (!forceRefresh) {
    if (cached && cached.accessToken && (!finite(cached.expiresAt) || cached.expiresAt - now > margin)) return cached.accessToken;
    if (account.accessToken && (!finite(account.expiresAt) || account.expiresAt - now > margin)) return account.accessToken;
  }
  if (account.refreshToken) { try { return await refreshAccessToken(account); } catch (e) { if (!forceRefresh && account.accessToken) return account.accessToken; throw e; } }
  if (account.accessToken && !forceRefresh) return account.accessToken;
  throw new Error(T.refreshNeedsClient);
}
async function fetchUserEmail(accessToken, key) {
  if (emailCache.has(key)) return emailCache.get(key);
  const controller = new AbortController(), timer = setTimeout(() => controller.abort(), 3000);
  try {
    const res = await fetch("https://openidconnect.googleapis.com/v1/userinfo", { signal: controller.signal, headers: { Authorization: `Bearer ${accessToken}`, Accept: "application/json" } });
    if (!res.ok) return "";
    const mail = String((JSON.parse(await res.text()) || {}).email || "").trim();
    if (mail) emailCache.set(key, mail);
    return mail;
  } catch { return ""; } finally { clearTimeout(timer); }
}

// -- Cloud Code Assist TLS 传输与模型配额解析 --
const targetOrigins = () => { const p = String(inputs.endpoint || "auto"); return p === "prod" ? [ENDPOINTS.prod] : p === "daily" ? [ENDPOINTS.daily] : [ENDPOINTS.daily, ENDPOINTS.prod]; };
function concatBytes(chunks) { let t = 0, o = 0; for (const c of chunks) t += c.length; const out = new Uint8Array(t); for (const c of chunks) { out.set(c, o); o += c.length; } return out; }
function findSequence(buf, seq, from = 0) { outer: for (let i = from; i <= buf.length - seq.length; i++) { for (let j = 0; j < seq.length; j++) if (buf[i + j] !== seq[j]) continue outer; return i; } return -1; }
function decodeChunkedBytes(buf) {
  const crlf = [13, 10], parts = [], dec = new TextDecoder();
  let pos = 0, complete = false;
  while (pos < buf.length) {
    const end = findSequence(buf, crlf, pos);
    if (end < 0) break;
    const size = parseInt(dec.decode(buf.subarray(pos, end)).split(";")[0].trim(), 16);
