const inferFamily = (id, name) => { const s = `${id} ${name}`.toLowerCase(); return /claude|opus|sonnet|haiku|^3p-|\b3p\b|third/.test(s) ? "claude" : /gpt|openai|\bo1\b|\bo3\b|\bo4\b/.test(s) ? "gpt" : /gemini|argon|carbon|hydrogen|neon/.test(s) ? "gemini" : "other"; };
const familyLabel = f => ({ gemini: "Gemini Models", claude: "Claude & GPT", gpt: "GPT", other: "Models" })[f] || "Models";
const prettifyModelId = id => String(id).split(/[-_]+/).filter(Boolean).map(w => (/^xhigh$/i.test(w) ? "XHigh" : w.charAt(0).toUpperCase() + w.slice(1))).join(" ");
const shortGroupName = name => String(name || "").replace(/\s+models?$/i, "").replace(/\band\b/i, "&").trim() || "Quota";

function extractModelVersion(id, displayName) {
  const s = `${displayName} ${id}`.toLowerCase(), m = /(?:gemini|claude|opus|sonnet|haiku|gpt)[^0-9]{0,14}(\d+)(?:[._-](\d+))?(?!\d*[bk]\b)/.exec(s);
  if (m) return Number(m[1]) * 100 + (m[2] ? Number(m[2]) : 0);
  const g = /(?:^|[\s_-])v?(\d+)(?:\.(\d+))?(?=$|[\s_-])/.exec(s);
  return g && Number(g[1]) < 30 ? Number(g[1]) * 100 + (g[2] ? Number(g[2]) : 0) : 0;
}
const extractTierScore = s => (/argon|ultra|opus/.test(s) ? 4 : /carbon|pro|sonnet/.test(s) ? 3 : /hydrogen|neon|flash/.test(s) ? 2 : /lite|haiku|mini/.test(s) ? 1 : 0);
const extractEffortScore = s => (/\bxhigh\b|\bmax\b/.test(s) ? 4 : /\bhigh\b/.test(s) ? 3 : /\bmedium\b/.test(s) ? 2 : /\blow\b/.test(s) ? 1 : 0);
const compareModelsNewestFirst = (a, b) => (a.isUtility - b.isUtility) || (a.pickerRank - b.pickerRank) || (b.recommended - a.recommended) || (b.versionScore - a.versionScore) || (b.tierScore - a.tierScore) || (b.effortScore - a.effortScore) || a.displayName.localeCompare(b.displayName);

function parseQuotaModels(raw) {
  if (!raw || typeof raw !== "object") throw new Error(T.invalidResp);
  const pickerRank = new Map();
  if (typeof raw.defaultAgentModelId === "string" && raw.defaultAgentModelId) pickerRank.set(raw.defaultAgentModelId, -1);
  if (Array.isArray(raw.agentModelSorts)) {
    let idx = 0;
    for (const s of raw.agentModelSorts) {
      const ids = Array.isArray(s && s.groups) ? s.groups.flatMap(g => (Array.isArray(g && g.modelIds) ? g.modelIds : [])) : Array.isArray(s && s.modelIds) ? s.modelIds : [];
      for (const id of ids) if (typeof id === "string" && !pickerRank.has(id)) pickerRank.set(id, idx++);
    }
  }
  const entries = Array.isArray(raw.models)
    ? raw.models.filter(m => m && typeof m === "object").map(m => [String(m.id || m.model || m.name || "").trim(), m]).filter(([id]) => id)
    : raw.models && typeof raw.models === "object" ? Object.entries(raw.models).filter(([, m]) => m && typeof m === "object") : [];
  const out = [];
  for (const [id, m] of entries) {
    if (m.isInternal === true && !m.displayName) continue;
    const q = m.quotaInfo || m.quota_info;
    if (!q || typeof q !== "object") continue;
    const resetMs = parseTimestamp(q.resetTime ?? q.reset_time);
    const remaining = finite(q.remainingFraction) ? q.remainingFraction * 100 : finite(q.remaining_fraction) ? q.remaining_fraction * 100 : finite(q.remainingPercentage) ? q.remainingPercentage : finite(q.remaining_percentage) ? q.remaining_percentage : finite(resetMs) ? 0 : NaN;
    if (!finite(remaining)) continue;
    const displayName = String(m.displayName || m.display_name || "").trim() || prettifyModelId(id), family = inferFamily(id, displayName), low = `${id} ${displayName}`.toLowerCase();
    const spanMs = finite(resetMs) ? (resetMs - Date.now() > 24 * 3600e3 ? D7 : H5) : 0;
    out.push({
      id, displayName, family, isPrimary: family === "gemini" && /argon|pro|flash/i.test(low), leftPct: Math.max(0, Math.min(100, remaining)), resetMs, spanMs,
      isUtility: (m.isInternal === true || /^tab_|^chat_|autocomplete|jump_/i.test(id)) ? 1 : 0,
      recommended: (m.recommended === true || m.isRecommended === true || /\bnew\b|\blatest\b/i.test(String(m.tagTitle || ""))) ? 1 : 0,
      pickerRank: pickerRank.has(id) ? pickerRank.get(id) : Infinity,
      versionScore: extractModelVersion(id, displayName), tierScore: extractTierScore(low), effortScore: extractEffortScore(low),
