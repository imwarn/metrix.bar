    if (lastErr && (lastErr.network || Date.now() > deadline - 3500)) break;
    let token = await resolveAccessToken(current, false);
    for (let attempt = 0; attempt < 2; attempt++) {
      try {
        const meta = readAccountMeta(current.key);
        let projectId = current.projectId || (meta && meta.projectId) || "", plan = (meta && meta.plan) || "", metaFresh = Boolean(meta);
        if (!metaFresh) {
