  if (Array.isArray(raw.agentModelSorts)) {
    let idx = 0;
    for (const s of raw.agentModelSorts) {
      const ids = Array.isArray(s && s.groups) ? s.groups.flatMap(g => (Array.isArray(g && g.modelIds) ? g.modelIds : [])) : Array.isArray(s && s.modelIds) ? s.modelIds : [];
