    const q = m.quotaInfo || m.quota_info;
    if (!q || typeof q !== "object") continue;
    const resetMs = parseTimestamp(q.resetTime ?? q.reset_time);
    let remaining = finite(q.remainingFraction) ? q.remainingFraction * 100 : finite(q.remaining_fraction) ? q.remaining_fraction * 100 : finite(q.remainingPercentage) ? q.remainingPercentage : finite(q.remaining_percentage) ? q.remaining_percentage : finite(resetMs) ? 0 : NaN;
    if (!finite(remaining)) continue;
